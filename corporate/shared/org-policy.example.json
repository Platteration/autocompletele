{
  "version": 1,
  "organization": "Example Logistics Ltd",
  "typing": { "charsPerMinute": 200, "secondsPerAttachment": 20, "secondsPerFiling": 45 },
  "capture": {
    "defaultMode": "triggers",
    "apps": [
      { "id": "outlook", "label": "Outlook", "mode": "learn", "match": { "process": ["outlook.exe", "Microsoft Outlook"], "bundleId": "com.microsoft.Outlook" } },
      { "id": "thunderbird", "label": "Thunderbird", "mode": "learn", "match": { "process": "thunderbird" } },
      { "id": "webmail", "label": "Web mail", "mode": "learn", "match": { "title": "(Gmail|Outlook|Mail) - " } },
      { "id": "banking", "label": "Banking portal", "mode": "off", "match": { "title": "Online Banking" } }
    ]
  },
  "library": {
    "version": 1,
    "shorthands": [
      { "trigger": "sig/", "expansion": "Kind regards,\n{cursor}\nExample Logistics Ltd\nwww.example.com" },
      { "trigger": "hrs/", "expansion": "Our office hours are Monday to Friday, 08:00 to 17:00." },
      { "trigger": "ack/", "expansion": "Hi [[name]],\n\nThanks for your message about [[subject]]. I will come back to you by [[date]].\n\nKind regards" },
      { "trigger": "ret/", "expansion": "Returns are accepted within 30 days of delivery. Please quote your order reference and keep the original packaging." }
    ]
  },
  "keywordRules": [
    { "id": "returns", "label": "Returns policy", "keywords": ["return", "returns", "refund"], "match": "any", "insert": { "kind": "shorthand", "trigger": "ret/" } },
    { "id": "shipping-docs", "label": "Shipping documents", "keywords": ["customs", "shipment"], "match": "all", "insert": { "kind": "document", "shortcut": "/sld" } },
    { "id": "office-hours", "label": "Office hours", "keywords": ["opening hours", "office hours"], "insert": { "kind": "text", "text": "Our office hours are Monday to Friday, 08:00 to 17:00." } },
    { "id": "contract-disclaimer", "label": "Contract disclaimer", "action": "warn", "keywords": ["contract", "agreement"], "unless": ["This message and any attachments are confidential"], "message": "Messages about contracts need the legal disclaimer.", "insert": { "kind": "text", "text": "This message and any attachments are confidential and intended only for the addressee." } },
    { "id": "card-numbers", "label": "Card numbers", "action": "warn", "detect": ["card-number"], "message": "Card numbers must not be sent by email. Use the secure payment link instead." }
  ],
  "documents": {
    "shortcuts": [
      {
        "trigger": "/sld",
        "label": "Shipping logistics department",
        "documents": [
          { "title": "Commercial invoice template", "path": "S:/Shared/Logistics/commercial-invoice.docx", "tags": ["customs", "export"] },
          { "title": "Packing list", "path": "S:/Shared/Logistics/packing-list.xlsx", "tags": ["warehouse"] },
          { "title": "Carrier contact sheet", "path": "S:/Shared/Logistics/carriers.pdf", "tags": ["contacts"] }
        ]
      },
      {
        "trigger": "/hr",
        "label": "Human resources onboarding",
        "documents": [
          { "title": "Employee handbook", "path": "S:/Shared/HR/handbook.pdf" },
          { "title": "Expense claim form", "path": "S:/Shared/HR/expense-claim.xlsx", "tags": ["finance"] }
        ]
      }
    ]
  },
  "filing": {
    "watch": [
      { "path": "~/Downloads", "label": "Downloads" },
      { "path": "S:/Scans/Finance", "label": "Finance scanner", "recursive": false }
    ],
    "dateOrder": "dmy",
    "fields": {
      "client": { "values": ["Acme Logistics GmbH", "Birch & Co", "Nordwind Shipping AS"], "aliases": { "ACME": "Acme Logistics GmbH", "Nordwind": "Nordwind Shipping AS" } },
      "ref": { "pattern": "\\b(INV|PO|CT)-\\d{4,}\\b" }
    },
    "rules": [
      { "id": "invoice", "label": "Supplier invoice", "when": { "keywords": ["invoice", "amount due", "rechnung"], "match": "any", "extensions": ["pdf", "docx", "xlsx"] }, "name": "[[date]]_[[client]]_invoice_[[ref]]", "folder": "S:/Shared/Finance/Invoices/[[year]]" },
      { "id": "purchase-order", "label": "Purchase order", "when": { "keywords": ["purchase order"], "match": "all" }, "name": "[[date]]_[[client]]_PO_[[ref]]", "folder": "S:/Shared/Finance/Purchase orders/[[year]]" },
      { "id": "contract", "label": "Contract", "when": { "keywords": ["agreement", "hereinafter"], "match": "all" }, "name": "[[date]]_[[client]]_contract", "folder": "S:/Shared/Legal/Contracts/[[client]]" },
      { "id": "packing-list", "label": "Packing list", "when": { "keywords": ["packing list"] }, "name": "[[date]]_packing-list_[[original]]", "folder": "S:/Shared/Logistics/Packing lists/[[year]]-[[month]]" }
    ],
    "fallback": { "label": "Other documents", "name": "[[date]]_[[original]]", "folder": "" }
  },
  "reply": {
    "max": 3,
    "dateOrder": "dmy",
    "extract": {
      "customer": {
        "after": "Customer ID"
      }
    },
    "replies": [
      {
        "id": "late-delivery",
        "label": "Late delivery",
        "keywords": [
          "not arrived",
          "late",
          "delayed",
          "still waiting"
        ],
        "match": "any",
        "text": "Dear [[firstName]],\n\nThank you for your message. I am sorry that order [[order]] has not reached you yet. I have asked the carrier for an update and will come back to you by [[promise]].\n\n{cursor}\n\nKind regards,\nExample Logistics Ltd"
      },
      {
        "id": "invoice-copy",
        "label": "Invoice copy",
        "keywords": [
          "invoice"
        ],
        "text": "Dear [[firstName]],\n\nPlease find attached a copy of invoice [[reference]] for order [[order]].\n\nKind regards,\nExample Logistics Ltd"
      },
      {
        "id": "returns",
        "label": "Returns and refunds",
        "keywords": [
          "return",
          "returns",
          "refund",
          "money back"
        ],
        "shorthand": "ret/"
      },
      {
        "id": "tracking",
        "label": "Tracking number",
        "keywords": [
          "tracking",
          "track my parcel",
          "where is my parcel"
        ],
        "text": "Dear [[firstName]],\n\nYou can follow parcel [[tracking]] at https://track.example.com/[[tracking]] (customer [[customer]]).\n\nKind regards,\nExample Logistics Ltd",
        "extract": {
          "tracking": {
            "pattern": "\\b1Z[A-Z0-9]{16}\\b"
          }
        }
      }
    ]
  },
  "sheets": {
    "vocabularies": {
      "customers": {
        "values": [
          "Acme Logistics GmbH",
          "Birch & Co",
          "Northern Acme Ltd",
          "Zed Transport"
        ],
        "aliases": {
          "ACME": "Acme Logistics GmbH",
          "Birch": "Birch & Co",
          "NAL": "Northern Acme Ltd"
        }
      },
      "costCentres": {
        "values": [
          "CC-100 Logistics",
          "CC-200 Sales",
          "CC-300 Warehouse"
        ],
        "aliases": {
          "Sales": "CC-200 Sales"
        }
      }
    },
    "columns": [
      {
        "match": {
          "header": "^(customer|client)",
          "sheet": "^Orders"
        },
        "vocabulary": "customers"
      },
      {
        "match": {
          "header": "^cost cent"
        },
        "vocabulary": "costCentres"
      },
      {
        "match": {
          "header": "notes?$"
        },
        "kind": "notes"
      }
    ],
    "blocks": [
      {
        "trigger": "/exp",
        "label": "Expense rows",
        "rows": [
          [
            "Date",
            "Amount",
            "Cost centre"
          ],
          [
            "",
            0,
            ""
          ]
        ]
      },
      {
        "trigger": "/vat",
        "label": "VAT at 19%",
        "formula": "=ROUND(B2*0.19, 2)"
      }
    ]
  },
  "forms": {
    "records": [
      {
        "id": "refund-case",
        "label": "Refund case",
        "trigger": "refund/",
        "fields": {
          "category": "Refund",
          "priority": "P2",
          "sla": "48",
          "notes": "Hi [[customer]], the refund for order [[orderRef]] is on its way. [[reason]]"
        }
      },
      {
        "id": "complaint",
        "label": "Complaint",
        "trigger": "cmp/",
        "fields": {
          "category": "Complaint",
          "priority": "P1",
          "sla": "24",
          "notes": "Complaint from [[customer]] about order [[orderRef]]: [[summary]]"
        }
      },
      {
        "id": "address-change",
        "label": "Address change",
        "fields": {
          "category": "Account",
          "priority": "P3",
          "notes": "New delivery address for [[customer]]: [[address]]"
        }
      }
    ],
    "lookups": [
      {
        "id": "orders",
        "key": "orderRef",
        "keyPattern": "A-\\d{5}",
        "rows": [
          {
            "orderRef": "A-12345",
            "customer": "Mary Jones",
            "email": "mary.jones@example.com"
          },
          {
            "orderRef": "A-54321",
            "customer": "John Smith",
            "email": "john.smith@example.com"
          },
          {
            "orderRef": "A-10021",
            "customer": "Priya Nair",
            "email": "priya.nair@example.com"
          }
        ]
      }
    ],
    "forms": [
      {
        "id": "ticket",
        "label": "Support ticket",
        "match": {
          "process": [
            "zendesk",
            "chrome"
          ],
          "title": "new ticket"
        },
        "fields": [
          {
            "name": "category",
            "label": "Category",
            "selector": "combobox:Category"
          },
          {
            "name": "priority",
            "label": "Priority",
            "selector": "combobox:Priority"
          },
          {
            "name": "customer",
            "label": "Requester",
            "selector": "edit:Requester"
          },
          {
            "name": "email",
            "label": "E-mail",
            "selector": "edit:Email"
          },
          {
            "name": "sla",
            "label": "SLA hours",
            "selector": "edit:SLA"
          },
          {
            "name": "notes",
            "label": "Internal note",
            "selector": "document:Internal note"
          }
        ]
      }
    ]
  },
  "guard": {
    "assumeExternal": false,
    "internalDomains": [
      "example.com"
    ],
    "internalCodes": [
      "\\bPRJ-[A-Z]{3,8}\\b"
    ],
    "packs": [
      {
        "id": "pci",
        "label": "Card data (PCI DSS)",
        "rules": [
          {
            "id": "card-number",
            "label": "Card number in a message",
            "detect": [
              "card-number"
            ],
            "severity": "block",
            "message": "A payment card number is in this message. Card data may only be entered in the payment system.",
            "fix": {
              "kind": "remove",
              "with": "[card number removed]"
            }
          }
        ]
      },
      {
        "id": "gdpr",
        "label": "Personal data (GDPR)",
        "rules": [
          {
            "id": "national-id",
            "label": "National ID number to an outside recipient",
            "detect": [
              "national-id"
            ],
            "countries": [
              "GB",
              "ES",
              "FR"
            ],
            "recipients": "external",
            "message": "A national identification number is going to someone outside the organisation.",
            "fix": {
              "kind": "remove"
            }
          },
          {
            "id": "secrets",
            "label": "Password or token in a message",
            "detect": [
              "secret"
            ],
            "severity": "block",
            "message": "Never send passwords or tokens in a message. Use the password manager's sharing feature."
          }
        ]
      },
      {
        "id": "legal",
        "label": "Legal",
        "rules": [
          {
            "id": "contract-disclaimer",
            "label": "Contract without the confidentiality notice",
            "keywords": [
              "contract",
              "agreement"
            ],
            "unless": [
              "This message is confidential"
            ],
            "message": "You are writing about a contract without the confidentiality notice.",
            "fix": {
              "kind": "text",
              "text": "This message is confidential and intended for the addressee only."
            }
          },
          {
            "id": "no-guarantees",
            "label": "Forbidden promise",
            "detect": [
              "forbidden-phrase"
            ],
            "phrases": [
              "guaranteed",
              "100% safe",
              "risk-free"
            ],
            "severity": "info",
            "message": "Do not promise guarantees; the terms of service say what we commit to.",
            "fix": {
              "kind": "remove"
            }
          },
          {
            "id": "project-codes",
            "label": "Internal project code to an outside recipient",
            "detect": [
              "internal-code"
            ],
            "recipients": "external",
            "message": "An internal project code is going outside the organisation.",
            "fix": {
              "kind": "remove",
              "with": "[project]"
            }
          }
        ]
      }
    ]
  },
  "notes": {
    "author": "author",
    "dateOrder": "dmy",
    "actions": {
      "heading": "Action items",
      "patterns": [
        "TODO",
        "ACTION"
      ],
      "empty": "None"
    },
    "documents": [
      {
        "id": "minutes",
        "trigger": "/mins",
        "label": "Meeting minutes",
        "title": "Minutes – [[meeting]]",
        "sections": [
          {
            "heading": "Details",
            "body": [
              "{weekday} {date}",
              "Minute taker: [[author]]"
            ]
          },
          {
            "heading": "Attendees",
            "body": "- [[attendees]]"
          },
          {
            "heading": "Discussion",
            "body": "{cursor}"
          },
          {
            "heading": "Decisions"
          }
        ]
      },
      {
        "id": "handover",
        "trigger": "/handover",
        "label": "Shift handover",
        "title": "Handover – {weekday} {date}",
        "sections": [
          {
            "heading": "Handing over",
            "body": "[[author]] to [[incoming]]"
          },
          {
            "heading": "Open items",
            "body": "{cursor}"
          },
          {
            "heading": "For the next shift"
          }
        ],
        "actions": {
          "heading": "Follow-ups"
        }
      },
      {
        "id": "shift-log",
        "trigger": "/shift",
        "label": "Shift log",
        "title": "Shift log – {date}",
        "sections": [
          {
            "heading": "Entries",
            "body": "{time} [[author]]: {cursor}"
          }
        ],
        "actions": false
      }
    ]
  },
  "learning": { "minCount": 3, "minLength": 20, "minWords": 4 },
  "retention": { "metricsDays": 365, "corpusDays": 90 }
}
