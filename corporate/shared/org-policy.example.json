{
  "version": 1,
  "organization": "Example Logistics Ltd",
  "updates": {
    "url": "https://intranet.example/actle/updates",
    "channel": "latest"
  },
  "typing": {
    "charsPerMinute": 200,
    "secondsPerAttachment": 20
  },
  "capture": {
    "defaultMode": "triggers",
    "apps": [
      {
        "id": "outlook",
        "label": "Outlook",
        "mode": "learn",
        "match": {
          "process": [
            "outlook.exe",
            "Microsoft Outlook"
          ],
          "bundleId": "com.microsoft.Outlook"
        }
      },
      {
        "id": "thunderbird",
        "label": "Thunderbird",
        "mode": "learn",
        "match": {
          "process": "thunderbird"
        }
      },
      {
        "id": "webmail",
        "label": "Web mail",
        "mode": "learn",
        "match": {
          "title": "(Gmail|Outlook|Mail) - "
        }
      },
      {
        "id": "banking",
        "label": "Banking portal",
        "mode": "off",
        "match": {
          "title": "Online Banking"
        }
      }
    ]
  },
  "library": {
    "version": 1,
    "shorthands": [
      {
        "trigger": "sig/",
        "expansion": "Kind regards,\n{cursor}\nExample Logistics Ltd\nwww.example.com"
      },
      {
        "trigger": "hrs/",
        "expansion": "Our office hours are Monday to Friday, 08:00 to 17:00."
      },
      {
        "trigger": "ack/",
        "expansion": "Hi [[name]],\n\nThanks for your message about [[subject]]. I will come back to you by [[date]].\n\nKind regards"
      },
      {
        "trigger": "ret/",
        "expansion": "Returns are accepted within 30 days of delivery. Please quote your order reference and keep the original packaging."
      }
    ]
  },
  "keywordRules": [
    {
      "id": "returns",
      "label": "Returns policy",
      "keywords": [
        "return",
        "returns",
        "refund"
      ],
      "match": "any",
      "insert": {
        "kind": "shorthand",
        "trigger": "ret/"
      }
    },
    {
      "id": "shipping-docs",
      "label": "Shipping documents",
      "keywords": [
        "customs",
        "shipment"
      ],
      "match": "all",
      "insert": {
        "kind": "document",
        "shortcut": "/sld"
      }
    },
    {
      "id": "office-hours",
      "label": "Office hours",
      "keywords": [
        "opening hours",
        "office hours"
      ],
      "insert": {
        "kind": "text",
        "text": "Our office hours are Monday to Friday, 08:00 to 17:00."
      }
    },
    {
      "id": "contract-disclaimer",
      "label": "Contract disclaimer",
      "action": "warn",
      "keywords": [
        "contract",
        "agreement"
      ],
      "unless": [
        "This message and any attachments are confidential"
      ],
      "message": "Messages about contracts need the legal disclaimer.",
      "insert": {
        "kind": "text",
        "text": "This message and any attachments are confidential and intended only for the addressee."
      }
    },
    {
      "id": "card-numbers",
      "label": "Card numbers",
      "action": "warn",
      "detect": [
        "card-number"
      ],
      "message": "Card numbers must not be sent by email. Use the secure payment link instead."
    },
    {
      "id": "bank-details",
      "label": "Bank details",
      "action": "warn",
      "detect": [
        "iban"
      ],
      "message": "Bank account numbers must not be sent by email."
    },
    {
      "id": "attachment-reminder",
      "label": "Attachment reminder",
      "action": "warn",
      "keywords": [
        "attached",
        "attachment",
        "enclosed"
      ],
      "detect": [
        "missing-attachment"
      ],
      "apps": [
        "outlook.exe",
        "Microsoft Outlook",
        "thunderbird"
      ],
      "message": "You mention an attachment, but nothing has been attached through a document shortcut yet."
    },
    {
      "id": "external-recipients",
      "label": "External recipients",
      "action": "warn",
      "detect": [
        "external-email-domain"
      ],
      "params": {
        "allowedDomains": [
          "example.com"
        ]
      },
      "message": "This message names an address outside example.com. Check it is meant to go out."
    }
  ],
  "documents": {
    "shortcuts": [
      {
        "trigger": "/sld",
        "label": "Shipping logistics department",
        "documents": [
          {
            "title": "Commercial invoice template",
            "path": "S:/Shared/Logistics/commercial-invoice.docx",
            "tags": [
              "customs",
              "export"
            ]
          },
          {
            "title": "Packing list",
            "path": "S:/Shared/Logistics/packing-list.xlsx",
            "tags": [
              "warehouse"
            ]
          },
          {
            "title": "Carrier contact sheet",
            "path": "S:/Shared/Logistics/carriers.pdf",
            "tags": [
              "contacts"
            ]
          }
        ]
      },
      {
        "trigger": "/hr",
        "label": "Human resources onboarding",
        "documents": [
          {
            "title": "Employee handbook",
            "path": "S:/Shared/HR/handbook.pdf"
          },
          {
            "title": "Expense claim form",
            "path": "S:/Shared/HR/expense-claim.xlsx",
            "tags": [
              "finance"
            ]
          }
        ]
      }
    ]
  },
  "lookups": [
    {
      "trigger": "/cust",
      "label": "Customer block",
      "source": {
        "kind": "csv",
        "path": "S:/Shared/Logistics/customers.csv",
        "key": "id",
        "refreshMinutes": 60
      },
      "template": "[[name]] ([[id]])\n[[address]]\nAccount manager: [[manager]]"
    }
  ],
  "collections": [
    {
      "id": "shipping-catalogue",
      "label": "Shipping catalogue",
      "audience": [
        "shipping"
      ],
      "library": [
        {
          "trigger": "eta/",
          "expansion": "Estimated arrival is [[date]]."
        },
        {
          "trigger": "cust/",
          "expansion": "Customs declaration attached; please confirm the HS codes."
        }
      ],
      "documents": {
        "shortcuts": [
          {
            "trigger": "/ship",
            "label": "Shipping forms",
            "documents": [
              {
                "title": "Customs declaration",
                "path": "S:/Shared/Logistics/forms/customs.pdf"
              },
              {
                "title": "Packing list",
                "path": "S:/Shared/Logistics/forms/packing-list.xlsx"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "shipping-contacts",
      "label": "Shipping contacts",
      "audience": [
        "engineering",
        "shipping"
      ],
      "library": [
        {
          "trigger": "shipdesk/",
          "expansion": "Shipping desk: shipping-desk@example.com, +44 20 7946 0000 (08:00 to 18:00)"
        }
      ],
      "keywordRules": [
        {
          "id": "shipping-desk",
          "label": "Shipping desk contact",
          "keywords": [
            "shipping desk"
          ],
          "insert": {
            "kind": "shorthand",
            "trigger": "shipdesk/"
          }
        }
      ]
    }
  ],
  "learning": {
    "minCount": 3,
    "minLength": 20,
    "minWords": 4
  },
  "retention": {
    "metricsDays": 365,
    "corpusDays": 90
  }
}
