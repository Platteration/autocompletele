<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plain console test runner (no test framework needed): `dotnet run` exits non-zero on failure. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>ShorthandExpander.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../ShorthandExpander/Expander.cs" />
    <Compile Include="../ShorthandExpander/Models.cs" />
    <Compile Include="../ShorthandExpander/ShorthandStore.cs" />
  </ItemGroup>

</Project>
